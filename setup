#!/bin/bash

cwd=$(pwd)
home_dir=home
nm_pre_up_dir=etc/NetworkManager/dispatcher.d/pre-up.d

for file in $cwd/$home_dir/*; do
    if [[ `basename $file` == 'config' ]]; then
        for file in $cwd/$home_dir/config/*; do
            ln -snfv $file ~/.config/`basename $file`
        done
    else
        ln -snfv $file ~/.`basename $file`
    fi
done

if [[ $1 == '--nm' ]]; then
    for file in $cwd/$nm_pre_up_dir/*; do
        sudo ln -snfv $file /$nm_pre_up_dir
    done
fi
